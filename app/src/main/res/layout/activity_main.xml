<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F0F0"
    android:padding="8dp">

    <!-- Top Navigation Tabs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#E0E0E0"
        android:padding="4dp">

        <TextView
            android:id="@+id/tv_tab_welcome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="8dp"
            android:text="WELCOME"
            android:textColor="#555555"
            android:textStyle="bold"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tv_tab_format"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="8dp"
            android:text="FORMAT"
            android:textColor="#555555"
            android:textStyle="bold"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tv_tab_download"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="8dp"
            android:text="DOWNLOAD"
            android:textColor="#00796B"
            android:textStyle="bold"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tv_tab_readback"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="8dp"
            android:text="READBACK"
            android:textColor="#555555"
            android:textStyle="bold"
            android:textSize="11sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="#00796B" />

    <!-- Container Utama -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- TAB 1: WELCOME -->
        <ScrollView
            android:id="@+id/layout_welcome"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:padding="16dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SP Flash Tool Mobile v1.0 Professional"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#00796B" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Fitur Lengkap:\n- DOWNLOAD: Menulis firmware (.img) ke target.\n- FORMAT: Menghapus blok memori target.\n- READBACK: Backup/dump memori target ke file .img."
                    android:textSize="13sp"
                    android:textColor="#333333" />
            </LinearLayout>
        </ScrollView>

        <!-- TAB 2: FORMAT -->
        <LinearLayout
            android:id="@+id/layout_format"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone"
            android:padding="16dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Format Flash Memory"
                android:textSize="14sp"
                android:textStyle="bold" />
            <RadioGroup
                android:id="@+id/rg_format_option"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">
                <RadioButton
                    android:id="@+id/rb_auto_format"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Auto Format Flash (Default)"
                    android:checked="true" />
                <RadioButton
                    android:id="@+id/rb_format_except_boot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Format Whole Flash Except Bootloader" />
            </RadioGroup>
        </LinearLayout>

        <!-- TAB 3: DOWNLOAD -->
        <LinearLayout
            android:id="@+id/layout_download"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <EditText
                        android:id="@+id/et_da_path"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Download-Agent (DA File)"
                        android:textSize="12sp"
                        android:focusable="false" />
                    <Button
                        android:id="@+id/btn_choose_da"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DA FILE"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <EditText
                        android:id="@+id/et_scatter_path"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Scatter-loading File"
                        android:textSize="12sp"
                        android:focusable="false" />
                    <Button
                        android:id="@+id/btn_choose_scatter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SCATTER"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#808080"
                android:padding="4dp"
                android:layout_marginTop="8dp">
                <TextView
                    android:layout_width="30dp"
                    android:layout_height="wrap_content"
                    android:text="[x]"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="10sp" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Name"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="10sp" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:text="Begin Address"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="10sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="File Location"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="10sp" />
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#FFFFFF">
                <LinearLayout
                    android:id="@+id/container_partitions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>

        <!-- TAB 4: READBACK -->
        <LinearLayout
            android:id="@+id/layout_readback"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone"
            android:padding="16dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Readback Memory (ROM Backup)"
                android:textSize="14sp"
                android:textStyle="bold" />
            <Button
                android:id="@+id/btn_select_readback_save"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pilih Lokasi Simpan File Backup (.img)"
                android:layout_marginTop="12dp" />
            <TextView
                android:id="@+id/tv_readback_path"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Target Save File: Belum dipilih"
                android:textSize="11sp"
                android:textColor="#666666"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Tombol Eksekusi Utam (START & STOP) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="8dp">
        <Button
            android:id="@+id/btn_download"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="START"
            android:backgroundTint="#2E7D32"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />
        <Button
            android:id="@+id/btn_stop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="STOP"
            android:backgroundTint="#C62828"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100"
        android:progress="0"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/tv_status_log"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="4dp"
        android:text="Status: Ready."
        android:textColor="#333333"
        android:textSize="11sp" />
</LinearLayout>
