<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#1E1E1E"
        android:padding="12dp"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SP FLASH TOOL MOBILE"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#00E676" />
        <TextView
            android:id="@+id/tv_status_log"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DISCONNECTED"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#FF5252" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:weightSum="4">
        <Button
            android:id="@+id/tv_tab_welcome"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="WELCOME"
            android:textSize="10sp"
            android:backgroundTint="#00796B"
            android:textColor="#FFFFFF" />
        <Button
            android:id="@+id/tv_tab_format"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="FORMAT"
            android:textSize="10sp"
            android:backgroundTint="#37474F"
            android:textColor="#FFFFFF" />
        <Button
            android:id="@+id/tv_tab_download"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="DOWNLOAD"
            android:textSize="10sp"
            android:backgroundTint="#37474F"
            android:textColor="#FFFFFF" />
        <Button
            android:id="@+id/tv_tab_readback"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="READBACK"
            android:textSize="10sp"
            android:backgroundTint="#37474F"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:background="#1E1E1E"
        android:padding="12dp">

        <ScrollView
            android:id="@+id/layout_welcome"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Panduan SP Flash Tool Mobile"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#00E676"
                    android:layout_marginBottom="8dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1. Siapkan file Scatter &amp; DA Custom.\n2. Hubungkan HP target via OTG.\n3. Pilih tab DOWNLOAD atau FORMAT sesuai kebutuhan servis."
                    android:textSize="12sp"
                    android:textColor="#B0BEC5" />
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/layout_format"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">
            <Button
                android:id="@+id/btn_format_userdata"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="FORMAT USERDATA &amp; CACHE"
                android:backgroundTint="#B71C1C"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_download"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">
            <EditText
                android:id="@+id/et_scatter_path"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Scatter File Path"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
            <Button
                android:id="@+id/btn_choose_scatter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PILIH SCATTER"
                android:backgroundTint="#00796B"
                android:textColor="#FFFFFF" />
            <EditText
                android:id="@+id/et_da_path"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="DA File Path"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:layout_marginTop="8dp" />
            <Button
                android:id="@+id/btn_choose_da"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PILIH DA CUSTOM"
                android:backgroundTint="#00796B"
                android:textColor="#FFFFFF" />
            <LinearLayout
                android:id="@+id/container_partitions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
            <Button
                android:id="@+id/btn_download"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="START FLASHING"
                android:backgroundTint="#2E7D32"
                android:textColor="#FFFFFF"
                android:layout_marginTop="8dp" />
            <Button
                android:id="@+id/btn_stop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="STOP"
                android:backgroundTint="#D32F2F"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_readback"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView
                android:id="@+id/tv_readback_path"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Readback Path: -"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
            <Button
                android:id="@+id/btn_select_readback_save"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PILIH LOKASI PENYIMPANAN"
                android:backgroundTint="#F57F17"
                android:textColor="#FFFFFF" />
        </LinearLayout>

    </FrameLayout>

    <ProgressBar
        android:id="@+id/progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginTop="4dp"
        android:background="#121212"
        android:padding="4dp">
        <TextView
            android:id="@+id/tv_console_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ready...\n"
            android:textColor="#00FF00"
            android:textSize="11sp" />
    </ScrollView>

</LinearLayout>
